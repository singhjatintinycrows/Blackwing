# Blackwing environment configuration — COPY to .env and fill in.
# .env is git-ignored. NEVER commit real credentials.

# --- AWS Bedrock (Mantle OpenAI-compatible endpoint) ---
AWS_REGION=ap-south-1
AWS_BEARER_TOKEN_BEDROCK=REPLACE_ME
BLACKWING_MODEL=openai.gpt-oss-120b-1:0

# --- Web app ---
BLACKWING_HOST=127.0.0.1
BLACKWING_PORT=8000
BLACKWING_SECRET_KEY=REPLACE_ME_WITH_RANDOM_STRING
BLACKWING_MAX_UPLOAD_MB=200

# --- Runtime harness ---
# Path to codex CLI; leave 'codex' to use PATH. Set BLACKWING_MODEL_MOCK=1 to
# run the engine against a local mock instead of a live model (useful for tests).
CODEX_BIN=codex
BLACKWING_MODEL_MOCK=0

# --- Local live stack ---
CODEX_PROXY_PORT=8791
TESTBED_PORT=8477
BLACKWING_ENGINE_MODE=agent
BLACKWING_AGENT=opencode
CODEX_REASONING=medium
